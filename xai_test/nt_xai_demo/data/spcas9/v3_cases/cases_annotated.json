  },
  "selection_authority": "cases.json",
  "rewrites_selection": false,
  "non_circularity": "This file depends on cases.json and cases.json depends on nothing downstream, so a reviewer can confirm non-circularity from the two files' dependency direction. The selection is addressed by `case_id` in the order the case table holds it, and no selection score (absolute error, head gap, error quartile, selection rank) is copied here - there is nothing in this file to re-rank on.",
  "heads": [
    "SpCas9",
    "SpCas9-NG",
    "evoCas9"
  ],
  "token_names": [
    "left_flank_plus_protospacer_5prime",
    "protospacer_6_11",
    "protospacer_12_17",
    "protospacer_18_23",
    "pam_plus_right_flank"
  ],
  "profile_definition": "mean |ISM delta| over a position's three alternative bases, per row, position and head; the reference base's slot is a true zero and is excluded from the mean",
  "pam_share_definition": "the case's mean ISM sensitivity over PAM positions 24-26 divided by its mean over the whole 30bp window, per head. Scale-free, because the heads' dynamic ranges differ about sixfold and a raw magnitude would report that difference as a difference in where the model reads. It is a share of the window, not a per-base PAM attribution.",
  "attribution_outlier": {
    "definition": "A case whose PAM share of the window's ISM sensitivity sits at or above the 90th percentile of **its own stratum's** rows, per head. Reported to describe a case the selection already made: selecting cases by the attribution the case study then explains is circular.",
    "threshold_percentile": 90,
    "use": "description only, never selection"
  },
  "ig_coverage": {
    "cases": 18,
    "cases_with_ig": 1,
    "note": "IG ran on the frozen 400-row subset, drawn under its own seed before the cases were selected, so a case carries IG only where the two lists happen to meet. A case without it is recorded as null rather than left out, and no case was chosen or dropped for being in the subset."
  },
  "head_order_note": "The per-case ordering is description, not selection: head_order_reversal.json reports the population figures, and reversal is not a selection criterion (#129 AC9).",
  "rollout_excluded": "Attention rollout is not an input. It has no head axis at all (docs/adr/0008-attention-rollout-is-head-invariant.md), so it cannot describe a per-head reading, and every figure here is per head.",
  "claim_limit": "Every figure here describes the model's internal information use - which positions or tokens its prediction depends on, and how its heads order one row. None of it is a claim about physical DNA/protein interaction.",
